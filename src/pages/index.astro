---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, TIKTOK_SHOP_URL } from '../consts';
import { getPublishedPosts } from '../lib/posts';

const posts = (await getPublishedPosts()).slice(0, 6);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				text-align: center;
				padding: 2em 1em 3em 1em;
			}
			.hero h1 {
					display: flex;
					align-items: center;
					justify-content: center;
					gap: 0.4em;
				}
				.hero h1 img {
					height: 1em;
					width: auto;
				}
				.hero p {
				max-width: 640px;
				margin: 0.5em auto 1.5em auto;
				color: rgb(var(--gray));
			}
			.hero-cta {
				display: inline-block;
				padding: 0.75em 1.5em;
				background: var(--accent);
				color: white;
				border-radius: 999px;
				text-decoration: none;
				font-weight: 700;
			}
			.hero-cta:hover {
				background: var(--accent-dark);
			}
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			@media (max-width: 720px) {
				ul li {
					width: 100%;
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1><Image src={logo} alt="" width={40} height={28} /> Caminho da Luz</h1>
				<p>{SITE_DESCRIPTION}</p>
				<a class="hero-cta" href={TIKTOK_SHOP_URL} target="_blank" rel="noopener noreferrer">
					🛍️ Conheça a loja no TikTok Shop
				</a>
			</section>
			<section>
				<h2>Últimos guias</h2>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
