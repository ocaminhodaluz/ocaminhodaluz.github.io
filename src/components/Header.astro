---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { SITE_TITLE, TIKTOK_SHOP_URL } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/" class="brand">
				<Image src={logo} alt="" width={40} height={28} />
				{SITE_TITLE}
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Início</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">Sobre</HeaderLink>
		</div>
		<div class="shop-link">
			<a href={TIKTOK_SHOP_URL} target="_blank" rel="noopener noreferrer" class="shop-button">
				🛍️ Loja no TikTok
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.brand img {
		height: 28px;
		width: auto;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.shop-button {
		display: inline-block;
		padding: 0.5em 1em !important;
		background: var(--accent);
		color: white !important;
		border-radius: 999px;
		font-weight: 600;
		border-bottom: none !important;
		white-space: nowrap;
	}
	.shop-button:hover {
		background: var(--accent-dark);
	}
	@media (max-width: 720px) {
		nav {
			flex-wrap: wrap;
			justify-content: center;
			padding: 0.5em 0;
		}
	}
</style>
