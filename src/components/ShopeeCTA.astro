---
import { SHOPEE_URL } from '../consts';

interface Props {
	// Link de afiliado específico (opcional). Se não passar, usa o link padrão da categoria.
	href?: string;
	// Texto do produto/oferta que aparece na chamada.
	text?: string;
}

const { href = SHOPEE_URL, text = 'Veja opções na Shopee usando meu link' } = Astro.props;
---

<a class="shopee-cta" href={href} target="_blank" rel="noopener noreferrer sponsored">
	<span class="icon">🛒</span>
	<span class="text">
		<strong>{text}</strong>
		<span class="subtext">Comprando por esse link, você me ajuda sem pagar nada a mais</span>
	</span>
	<span class="arrow">→</span>
</a>

<style>
	.shopee-cta {
		display: flex;
		align-items: center;
		gap: 0.75em;
		margin: 2em 0;
		padding: 1em 1.25em;
		background: linear-gradient(135deg, #f53d2d, #ee4d2d);
		color: white;
		border-radius: 14px;
		text-decoration: none;
		box-shadow: var(--box-shadow);
		transition: transform 0.15s ease;
	}
	.shopee-cta:hover {
		transform: translateY(-2px);
		color: white;
	}
	.icon {
		font-size: 1.8em;
		line-height: 1;
	}
	.text {
		display: flex;
		flex-direction: column;
		flex: 1;
	}
	.text strong {
		font-size: 1.05em;
	}
	.subtext {
		font-size: 0.8em;
		opacity: 0.85;
	}
	.arrow {
		font-size: 1.5em;
	}
</style>
