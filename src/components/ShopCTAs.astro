---
import TikTokShopCTA from './TikTokShopCTA.astro';
import ShopeeCTA from './ShopeeCTA.astro';

interface Props {
	tiktokHref?: string;
	tiktokText?: string;
	shopeeHref?: string;
	shopeeText?: string;
}

const { tiktokHref, tiktokText, shopeeHref, shopeeText } = Astro.props;
---

<div class="shop-ctas">
	<TikTokShopCTA href={tiktokHref} text={tiktokText} />
	<ShopeeCTA href={shopeeHref} text={shopeeText} />
</div>

<style>
	.shop-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 1em;
	}
	.shop-ctas > :global(a) {
		flex: 1 1 260px;
		margin: 1em 0;
	}
</style>
